{
  "name": "workshop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Claude Code sessions in one window, beside a column of small apps anyone can write.",
  "main": "./out/main/index.js",
  "bin": {
    "workshop": "bin/workshop.mjs",
    "workshop-tile": "bin/workshop-tile.mjs"
  },
  "scripts": {
    "dev": "vite build --config vite.tile-preload.config.ts --logLevel warn && vite build --config vite.check.config.ts --logLevel warn && electron-vite dev --watch",
    "build": "electron-vite build && vite build --config vite.tile-preload.config.ts --logLevel warn && vite build --config vite.check.config.ts --logLevel warn",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke",
    "site": "vite build --config vite.site.config.ts",
    "readme-art": "node scripts/knot-svg.mjs",
    "icon": "electron scripts/icon.mjs",
    "dist": "npm run build && node scripts/stamp.mjs && electron-builder --mac",
    "install-app": "node scripts/install-app.mjs",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "build": {
    "appId": "app.dosha.workshop",
    "productName": "workshop",
    "copyright": "Copyright © 2026 DoshaLabs",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      "tmux.conf",
      "bin",
      "tiles",
      "template",
      "assets",
      "plugin",
      "native",
      {
        "from": "out/check",
        "to": "out/check"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Tiles that show what is playing read and control Music and Spotify.",
        "NSMicrophoneUsageDescription": "The screen recorder records the Mac's sound (through BlackHole) and, if you ask, your microphone. A tile you have allowed the microphone may use it too.",
        "NSCameraUsageDescription": "Only for a tile you have allowed the camera."
      }
    }
  },
  "dependencies": {
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.7.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.7.0",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  }
}
