{
  "id": "git",
  "name": "Git",
  "version": "0.3.0",
  "workshop": "^1.4",
  "author": "DoshaLabs",
  "repo": "https://github.com/DoshaLabs/workshop",
  "hint": "What each session has changed, every worktree, and the history, by project",
  "icon": "icon.svg",
  "entry": "dist/index.html",
  "pane": true,
  "span": 2,
  "permissions": {
    "sessions": "launch",
    "door": { "ops": ["show"], "timeoutMs": 15000 }
  },
  "backend": {
    "entry": "backend.mjs",
    "ops": ["changes", "diff", "worktrees", "diffmain", "rebase", "merge", "remove", "history", "commit"],
    "timeoutMs": 60000
  }
}
