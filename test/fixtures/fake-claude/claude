#!/usr/bin/env node
// A stand-in for the `claude` CLI, used only by `npm run smoke`. Like the real one it reads the
// --settings file, puts its `env` into its own environment, and runs its hook and status-line
// commands through the shell with JSON on stdin. Each line typed into it is a "turn":
//   prompt hook → (the line's action) → status line → Stop hook → prints "DONE <line>".
// Actions: `door` calls the probe tile through $WORKSHOP_TILE; `tile <id> <op> [args]` calls any
// tile the same way (as a skill would); `doc <args>` runs the preview pane's CLI ($WORKSHOP_DOC); `spoof` sends a Stop hook that
// claims another session's id; `bash <command>` runs a shell command in its folder as the Bash tool
// would, then fires PostToolUse with the payload Claude Code 2.1.322 sends (matchers honoured, and
// `tool_response.gitOperation` when the output reads like git commit's). It writes what it was started with to $WORKSHOP_HOME/fake-<id>.json.
// Like the real CLI it appends each turn to $CLAUDE_CONFIG_DIR/projects/<its folder>/<session id>.jsonl
// (the file appears at the first prompt): the prompt, prose with markdown, a tool call and its
// result, a subagent's line and a meta line (which a tile must not show), and a title.
// `agent <how>` runs a subagent the way Claude Code 2.1.322 does (seen with a real Haiku run,
// docs/progress/2026-11-11-wolfpack.md): SubagentStart with the parent's session id, the agent's own
// transcript at <parent's folder>/<session id>/subagents/agent-<id>.jsonl (every line isSidechain)
// with an agent-<id>.meta.json sidecar, then SubagentStop naming the file. <how>: `stop` (that, with
// a beat between start and stop), `nostop` (no stop hook, the sidecar says finished and the file is
// old: the web-fetch agent's way), `hold` (it never ends), `fork` (a stop for an agent that wrote no
// transcript: the CLI's internal forks), `workflow` (under workflows/wf_<run>/, its stop naming no
// file). The agent's id goes to $WORKSHOP_HOME/fake-agent-<how>.txt.
const { execSync } = require('node:child_process')
const fs = require('node:fs')
const path = require('node:path')

const args = process.argv.slice(2)
const after = (flag) => (args.includes(flag) ? args[args.indexOf(flag) + 1] : undefined)
const sid = after('--session-id') || after('--resume')
const settings = JSON.parse(fs.readFileSync(after('--settings'), 'utf8'))
Object.assign(process.env, settings.env || {})
fs.writeFileSync(path.join(process.env.WORKSHOP_HOME, `fake-${process.env.WORKSHOP_SESSION}.json`), JSON.stringify({ args, auth: process.env.WORKSHOP_AUTH, session: process.env.WORKSHOP_SESSION }))

const run = (cmd, input) => {
  try {
    return execSync(cmd, { input: JSON.stringify(input), shell: '/bin/sh', env: process.env, encoding: 'utf8', timeout: 10000 })
  } catch (err) {
    return String(err.stdout || err.message)
  }
}
const hook = (event, extra = {}, tool) => {
  for (const group of settings.hooks[event] || []) {
    // A matcher is a tool name or a regular expression over it; none (or "*") matches every tool.
    if (tool && group.matcher && group.matcher !== '*' && !new RegExp(`^(?:${group.matcher})$`).test(tool)) continue
    for (const h of group.hooks) run(h.command, { session_id: sid, hook_event_name: event, ...extra })
  }
}

// The Bash tool: the command in this folder, then PostToolUse as the real CLI sends it.
const bash = (command) => {
  const t0 = Date.now()
  let stdout = ''
  let stderr = ''
  try {
    stdout = execSync(command, { shell: '/bin/sh', cwd: process.cwd(), encoding: 'utf8', timeout: 20000, stdio: ['ignore', 'pipe', 'pipe'] })
  } catch (err) {
    stdout = String(err.stdout || '')
    stderr = String(err.stderr || err.message)
  }
  const made = /^\[(\S+)(?: \(root-commit\))? ([0-9a-f]{7,})\]/m.exec(stdout)
  const response = { stdout, stderr, interrupted: false, isImage: false, noOutputExpected: false, ...(made ? { gitOperation: { commit: { sha: made[2], kind: 'committed', branch: made[1] } } } : {}) }
  hook(
    'PostToolUse',
    { transcript_path: transcript, cwd: process.cwd(), permission_mode: 'default', tool_name: 'Bash', tool_input: { command, description: 'Run a command' }, tool_response: response, tool_use_id: `toolu_bash_${Date.now()}`, duration_ms: Date.now() - t0 },
    'Bash'
  )
  return stdout + stderr
}

// The folder name is the CLI's own encoding of the cwd; core never relies on it (it finds the file by id).
const transcript = process.env.CLAUDE_CONFIG_DIR ? path.join(process.env.CLAUDE_CONFIG_DIR, 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'), `${sid}.jsonl`) : null
let titled = false
const write = (o) => {
  if (!transcript) return
  fs.mkdirSync(path.dirname(transcript), { recursive: true })
  fs.appendFileSync(transcript, JSON.stringify({ sessionId: sid, timestamp: new Date().toISOString(), isSidechain: false, ...o }) + '\n')
}
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
const agent = (how) => {
  const aid = 'a' + require('node:crypto').randomBytes(8).toString('hex')
  fs.writeFileSync(path.join(process.env.WORKSHOP_HOME, `fake-agent-${how}.txt`), aid)
  const base = path.join(path.dirname(transcript), sid, 'subagents')
  const dir = how === 'workflow' ? path.join(base, 'workflows', 'wf_run1') : base
  const file = path.join(dir, `agent-${aid}.jsonl`)
  const meta = (finished) => ({ agentType: how === 'workflow' ? 'workflow-subagent' : 'general-purpose', isBuiltIn: true, description: `smoke ${how}`, ...(how === 'workflow' ? { workflowPhase: 'Build' } : {}), spawnDepth: 1, requestShape: 'background', pickedEffortModel: 'claude-haiku-5-5', finished })
  const type = how === 'workflow' ? 'workflow-subagent' : 'general-purpose'
  if (how === 'fork') {
    hook('SubagentStop', { transcript_path: transcript, cwd: process.cwd(), agent_id: aid, agent_type: type, agent_transcript_path: file, last_assistant_message: 'fork' })
    return
  }
  hook('SubagentStart', { transcript_path: transcript, cwd: process.cwd(), agent_id: aid, agent_type: type })
  fs.mkdirSync(dir, { recursive: true })
  const line = (o) => fs.appendFileSync(file, JSON.stringify({ isSidechain: true, agentId: aid, sessionId: sid, timestamp: new Date().toISOString(), ...o }) + '\n')
  line({ type: 'user', message: { role: 'user', content: `Brief for the ${how} agent: read the README.` } })
  line({ type: 'attachment', attachment: { type: 'deferred_tools_delta' } })
  line({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'tool_use', id: `toolu_${aid}`, name: 'Read', input: { file_path: path.join(process.cwd(), 'README.md') } }] } })
  line({ type: 'user', message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: `toolu_${aid}`, content: 'ok' }] } })
  line({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: `The ${how} agent read it.` }] } })
  fs.writeFileSync(file.replace(/\.jsonl$/, '.meta.json'), JSON.stringify(meta(how === 'nostop')))
  if (how === 'nostop') {
    const old = new Date(Date.now() - 60_000)
    fs.utimesSync(file, old, old)
    return
  }
  if (how === 'hold') return
  sleep(1500)
  fs.writeFileSync(file.replace(/\.jsonl$/, '.meta.json'), JSON.stringify(meta(true)))
  hook('SubagentStop', { transcript_path: transcript, cwd: process.cwd(), agent_id: aid, agent_type: type, ...(how === 'workflow' ? {} : { agent_transcript_path: file }), last_assistant_message: `The ${how} agent read it.` })
}

let calls = 0
const turn = (line) => {
  write({ type: 'user', origin: { kind: 'human' }, promptSource: 'typed', message: { role: 'user', content: line } })
  write({ type: 'user', isMeta: true, message: { role: 'user', content: 'META NOT SHOWN' } })
  write({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: `Looking into **${line}**.` }] } })
  const id = `toolu_${++calls}`
  write({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'tool_use', id, name: 'Read', input: { file_path: path.join(process.cwd(), 'README.md') } }] } })
  write({ type: 'user', message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: id, content: 'ok' }] } })
  write({ type: 'assistant', isSidechain: true, message: { role: 'assistant', content: [{ type: 'text', text: 'SIDECHAIN NOT SHOWN' }] } })
  write({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: `Finished \`${line}\`:\n\n- one\n- two` }] } })
  if (!titled) {
    titled = true
    write({ type: 'ai-title', aiTitle: 'Smoke conversation' })
  }
}

console.log('FAKE CLAUDE READY')
let buf = ''
process.stdin.setEncoding('utf8')
process.stdin.on('data', (chunk) => {
  buf += chunk.replace(/\x1b\[20[01]~/g, '')
  let i
  while ((i = buf.search(/[\r\n]/)) >= 0) {
    const line = buf.slice(0, i).trim()
    buf = buf.slice(i + 1)
    if (!line) continue
    turn(line)
    hook('UserPromptSubmit', { prompt: line })
    if (line === 'door') console.log(run(`node "$WORKSHOP_TILE" probe echo from-session`, {}).replace(/\s+/g, ' '))
    if (line.startsWith('tile ')) console.log(run(`node "$WORKSHOP_TILE" ${line.slice(5)} 2>&1`, {}).replace(/\s+/g, ' '))
    if (line.startsWith('doc ')) console.log(run(`node "$WORKSHOP_DOC" ${line.slice(4)} 2>&1`, {}).replace(/\s+/g, ' '))
    if (line.startsWith('bash ')) console.log(`BASH ${bash(line.slice(5)).replace(/\s+/g, ' ')}`)
    if (line.startsWith('agent ')) agent(line.slice(6).trim())
    run(settings.statusLine.command, { session_id: sid, rate_limits: { five_hour: { used_percentage: 42, resets_at: Math.floor(Date.now() / 1000) + 3600 } }, cost: { total_cost_usd: 1.23 }, context_window: { used_percentage: 17 } })
    if (line === 'spoof') {
      for (const group of settings.hooks.Stop || []) for (const h of group.hooks) run(h.command, { session_id: '00000000-0000-0000-0000-000000000000', hook_event_name: 'Stop' })
    } else hook('Stop')
    console.log(`DONE ${line}`)
  }
})
