#!/usr/bin/env node
// A stand-in for OpenAI's `codex` CLI, used only by `npm run smoke` (src/main/smoke-codex.ts).
// Shaped on codex-cli 0.167.1 as workshop runs it (docs/progress/2026-11-11-codex.md):
//
// - `codex app-server --listen unix://<path> [-c …]`: JSON-RPC over a WebSocket (upgrade to /rpc)
//   on that socket, as the real one: initialize, thread/loaded/list, thread/read, thread/resume
//   (subscribes the caller), thread/items/list (newest first). It writes its argv, folder and the
//   WORKSHOP_* names in its env to $WORKSHOP_HOME/fake-codex-server-<$WORKSHOP_SESSION>.json.
// - Anything else is the TUI: `[resume <id>] --remote unix://<path> -C <dir> [flags] [-- prompt]`.
//   It connects to the server as a client (refusing to run without one), starts its thread (the
//   resumed id, else a new one) plus an ephemeral side thread (Codex's own side work: core must
//   ignore it), writes its argv to <path>.tui.json, prints `FAKE CODEX <argv>` and `CONNECTED`.
//   Each line typed is a turn: status active, the prompt, `touch hello.txt` run, a markdown reply,
//   token usage, turn completed, status idle, and a name for the thread after the first. `ask`
//   instead asks for approval of `rm -rf build` (a server request to every subscriber), `askfile`
//   for a file change (its fileChange item first, as the real one), `askperm` for permissions
//   plus a question (item/tool/requestUserInput, which core must never answer). Every answer a
//   client sends is written to <path>.answers.json; the first answer to a request resolves it
//   (`serverRequest/resolved` to everyone, the item done or declined, status idle), as typing
//   `yes` in the TUI resolves them all. `slow` starts a turn that runs (a command in progress)
//   until a client sends turn/interrupt (writes <path>.interrupts.json; the command fails, the
//   turn completes `interrupted`, its open requests resolve, status idle). `commit` really runs
//   `git commit --allow-empty -m codex` in the server's folder and reports it as a command item;
//   `quietcommit` does the same but stores the item without sending it (as 0.167.1 did for a
//   thread's first turn), so only reading the turn back finds it. Subagents, as 0.167.1 runs
//   them: a child thread (parentThreadId, a nickname, source.subAgent.thread_spawn) whose events go
//   only to its own subscribers, and `subAgentActivity` items on the parent. `spawn`: the child
//   answers OK at once (before anyone can subscribe), then the parent says done. `spawnslow`: the
//   child runs a command until its turn is interrupted, which the parent hears as `interrupted`.
//   `spawnask`: the child asks to approve a command (sent to the child's and the parent's
//   subscribers, as the TUI follows only the parent); `yes` resolves it. A child refuses
//   thread/resume for its first 400 ms. An MCP server given as `-c mcp_servers.<name>={command=…,
//   args=[…],env_vars=[…]}` is started as 0.167.1 starts one (stdio, in the server's folder, its env
//   cleared to a few names plus `env_vars`); `mcpServerStatus/list` and `mcpServer/tool/call`
//   reach it, as they do the real one's.
//   `exit` ends the TUI cleanly (status 0), `crash` with status 3.

const fs = require('node:fs')
const http = require('node:http')
const path = require('node:path')
const { randomUUID } = require('node:crypto')
const { WebSocket, WebSocketServer } = require('ws')

const argv = process.argv.slice(2)
const sockOf = (flag) => {
  const at = argv.indexOf(flag)
  return at >= 0 ? String(argv[at + 1]).replace(/^unix:\/\//, '') : ''
}

if (argv[0] === '--version') {
  console.log('codex-cli 0.0.0-fake')
  process.exit(0)
}

if (argv[0] === 'app-server') server()
else tui()

function server() {
  const sock = sockOf('--listen')
  if (!sock) {
    console.error('fake codex: app-server needs --listen unix://<path>')
    process.exit(2)
  }
  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => k.startsWith('WORKSHOP_')))
  if (process.env.WORKSHOP_HOME) {
    fs.writeFileSync(path.join(process.env.WORKSHOP_HOME, `fake-codex-server-${process.env.WORKSHOP_SESSION || 'none'}.json`), JSON.stringify({ argv, cwd: process.cwd(), env }))
  }
  /** id → { thread, items: [{turnId, item, startedAtMs, completedAtMs}], subs: Set<ws> } */
  const threads = new Map()
  /** Open server requests: { th, id, itemId? } */
  let pending = []
  let reqId = 1000
  let named = false
  const send = (ws, m) => ws.readyState === WebSocket.OPEN && ws.send(JSON.stringify({ jsonrpc: '2.0', ...m }))
  const notify = (th, method, params) => {
    for (const ws of th.subs) send(ws, { method, params: { threadId: th.thread.id, ...params } })
  }
  const makeThread = (id, ephemeral) => {
    const thread = { id, cwd: process.cwd(), ephemeral, parentThreadId: null, source: 'cli', createdAt: Math.floor(Date.now() / 1000), name: null, status: { type: 'idle' }, preview: '' }
    const th = { thread, items: [], subs: new Set() }
    threads.set(id, th)
    return th
  }
  const status = (th, s) => {
    th.thread.status = s
    notify(th, 'thread/status/changed', { status: s })
  }
  const item = (th, turnId, it, done) => {
    const at = Date.now()
    if (done) {
      const had = th.items.find((e) => e.item.id === it.id)
      if (had) Object.assign(had, { item: it, completedAtMs: at })
      else th.items.push({ turnId, item: it, startedAtMs: at, completedAtMs: at })
    } else th.items.push({ turnId, item: it, startedAtMs: at, completedAtMs: null })
    notify(th, done ? 'item/completed' : 'item/started', { item: it, turnId, completedAtMs: at })
  }
  const exec = (id, status, exitCode) => ({ type: 'commandExecution', id, command: "/bin/zsh -lc 'touch hello.txt'", cwd: process.cwd(), status, exitCode, aggregatedOutput: null, commandActions: [], processId: null, source: 'agent', pluginId: null, scriptPath: null, durationMs: null })
  const interrupts = []
  /** The running turn per thread: { id, cmd? } */
  const running = new Map()
  const startTurn = (th) => {
    const t = { id: randomUUID(), status: 'inProgress' }
    th.turns = [...(th.turns || []), t]
    running.set(th.thread.id, t)
    notify(th, 'turn/started', { turn: { id: t.id, items: [], status: 'inProgress' } })
    return t
  }
  const endTurn = (th, t, st) => {
    t.status = st
    running.delete(th.thread.id)
    notify(th, 'turn/completed', { turn: { id: t.id, items: [], status: st } })
  }
  const turn = (th, text) => {
    const t = startTurn(th)
    const turnId = t.id
    status(th, { type: 'active', activeFlags: [] })
    item(th, turnId, { type: 'userMessage', id: randomUUID(), clientId: null, content: [{ type: 'text', text, text_elements: [] }] }, true)
    const c = randomUUID()
    item(th, turnId, exec(c, 'inProgress', null), false)
    item(th, turnId, exec(c, 'completed', 0), true)
    item(th, turnId, { type: 'agentMessage', id: randomUUID(), text: `Made **hello.txt** for: ${text}\n\n- one\n- two`, phase: null, memoryCitation: null, delivery: null, questions: null }, true)
    notify(th, 'thread/tokenUsage/updated', { turnId, tokenUsage: { total: { totalTokens: 13931 }, last: { totalTokens: 25840, inputTokens: 25000, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 840, reasoningOutputTokens: 0 }, modelContextWindow: 258400 } })
    endTurn(th, t, 'completed')
    status(th, { type: 'idle' })
    if (!named) {
      named = true
      th.thread.name = 'Make hello.txt'
      notify(th, 'thread/name/updated', { threadName: 'Make hello.txt' })
      // The side thread gets a name of its own: core must not take it.
      for (const side of threads.values()) if (side.thread.ephemeral) notify(side, 'thread/name/updated', { threadName: 'SIDE THREAD' })
    }
  }
  const answers = []
  // MCP servers from -c mcp_servers.<name>={…}: the value parsed just enough for workshop's.
  const mcp = new Map()
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] !== '-c') continue
    const m = /^mcp_servers\.([A-Za-z0-9_-]+)=\{command="([^"]+)",args=\[(.*?)\](?:,env_vars=\[(.*?)\])?\}$/.exec(argv[i + 1] || '')
    if (!m) continue
    const list = (x) => (x ? JSON.parse(`[${x}]`) : [])
    const keep = ['HOME', 'LANG', 'LOGNAME', 'PATH', 'SHELL', 'TERM', 'TMPDIR', 'USER', ...list(m[4])]
    const env = Object.fromEntries(keep.filter((k) => process.env[k] !== undefined).map((k) => [k, process.env[k]]))
    const child = require('node:child_process').spawn(m[2], list(m[3]), { cwd: process.cwd(), env, stdio: ['pipe', 'pipe', 'inherit'] })
    const waiting = new Map()
    let n = 1
    require('node:readline').createInterface({ input: child.stdout }).on('line', (l) => {
      try { const x = JSON.parse(l); waiting.get(x.id)?.(x); waiting.delete(x.id) } catch {}
    })
    const rpc = (method, params) => new Promise((ok) => { const id = n++; waiting.set(id, ok); child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n') })
    const ready = rpc('initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'codex-mcp-client', version: '0.0.0-fake' } })
    mcp.set(m[1], { rpc, ready, child })
    process.on('exit', () => child.kill())
  }
  const request = (th, method, params, fileItem, alsoTo, onAnswer) => {
    const r = { th, id: reqId++, fileItem, onAnswer }
    pending.push(r)
    const to = new Set([...th.subs, ...(alsoTo ? alsoTo.subs : [])])
    for (const ws of to) send(ws, { id: r.id, method, params: { threadId: th.thread.id, turnId: 't', startedAtMs: Date.now(), ...params } })
  }
  const resolve = (r, result) => {
    const decision = result?.decision
    r.onAnswer?.(result)
    notify(r.th, 'serverRequest/resolved', { requestId: r.id })
    if (r.th.root) notify(r.th.root.th, 'serverRequest/resolved', { requestId: r.id })
    if (r.fileItem) item(r.th, 't', { ...r.fileItem, status: decision === 'accept' ? 'completed' : 'declined' }, true)
    if (!pending.some((x) => x.th === r.th)) status(r.th, { type: 'idle' })
  }
  const hs = http.createServer((_q, r) => r.writeHead(426).end())
  const wss = new WebSocketServer({ server: hs, path: '/rpc' })
  wss.on('connection', (ws) => {
    ws.on('close', () => {
      for (const th of threads.values()) th.subs.delete(ws)
    })
    ws.on('message', async (data) => {
      let m
      try { m = JSON.parse(String(data)) } catch { return }
      const reply = (result) => send(ws, { id: m.id, result })
      if (m.id !== undefined && !m.method) {
        // An answer to a server request: the first one wins.
        answers.push(m)
        fs.writeFileSync(`${sock}.answers.json`, JSON.stringify(answers))
        const at = pending.findIndex((r) => r.id === m.id)
        if (at >= 0) resolve(pending.splice(at, 1)[0], m.result)
        return
      }
      const p = m.params || {}
      switch (m.method) {
        case 'initialize': return reply({ userAgent: 'fake/0', codexHome: '', platformFamily: 'unix', platformOs: 'macos' })
        case 'initialized': return
        case 'thread/loaded/list': return reply({ data: [...threads.keys()], nextCursor: null })
        case 'thread/read': {
          const th = threads.get(p.threadId)
          return th ? reply({ thread: th.thread }) : send(ws, { id: m.id, error: { code: -32600, message: 'no such thread' } })
        }
        case 'thread/resume': {
          const th = threads.get(p.threadId)
          if (!th) return send(ws, { id: m.id, error: { code: -32600, message: 'no such thread' } })
          // A subagent just spawned is not ready to join yet (as 0.167.1 seemed to answer).
          if (th.born && Date.now() - th.born < 400) return send(ws, { id: m.id, error: { code: -32600, message: 'thread not loaded' } })
          th.subs.add(ws)
          return reply({ thread: th.thread, model: 'fake', cwd: th.thread.cwd })
        }
        case 'mcpServerStatus/list': {
          const data = []
          for (const [name, srv] of mcp) {
            await srv.ready
            const r = await srv.rpc('tools/list', {})
            data.push({ name, tools: Object.fromEntries((r.result?.tools ?? []).map((t) => [t.name, t])), error: r.error ?? null })
          }
          return reply({ data, nextCursor: null })
        }
        case 'mcpServer/tool/call': {
          const srv = mcp.get(p.server)
          if (!srv) return send(ws, { id: m.id, error: { code: -32600, message: `no MCP server ${p.server}` } })
          await srv.ready
          const r = await srv.rpc('tools/call', { name: p.tool, arguments: p.arguments ?? {}, _meta: { threadId: p.threadId } })
          return r.error ? send(ws, { id: m.id, error: r.error }) : reply(r.result)
        }
        // The plan's windows, shaped as a free plan's on 0.167.1: one 30-day window, no secondary.
        case 'account/rateLimits/read':
          return reply({ rateLimits: { limitId: 'codex', limitName: null, primary: { usedPercent: 7, windowDurationMins: 43200, resetsAt: Math.floor(Date.now() / 1000) + 20 * 86400 }, secondary: null, credits: null, planType: 'free' }, rateLimitsByLimitId: null })
        case 'thread/unsubscribe': {
          const th = threads.get(p.threadId)
          if (th) th.subs.delete(ws)
          return reply({})
        }
        case 'thread/turns/list': {
          const th = threads.get(p.threadId)
          const data = th ? [...(th.turns || [])].reverse().slice(0, p.limit || 50).map((t) => ({ id: t.id, items: [], status: t.status })) : []
          return reply({ data, nextCursor: null, backwardsCursor: null })
        }
        case 'turn/interrupt': {
          interrupts.push(p)
          fs.writeFileSync(`${sock}.interrupts.json`, JSON.stringify(interrupts))
          const th = threads.get(p.threadId)
          const t = th && running.get(th.thread.id)
          if (!t || t.id !== p.turnId) return send(ws, { id: m.id, error: { code: -32600, message: 'no such turn' } })
          reply({})
          if (t.cmd) item(th, t.id, { ...t.cmd, status: 'failed', exitCode: null }, true)
          for (const r of pending.filter((x) => x.th === th)) {
            pending.splice(pending.indexOf(r), 1)
            notify(th, 'serverRequest/resolved', { requestId: r.id })
          }
          endTurn(th, t, 'interrupted')
          status(th, { type: 'idle' })
          // A subagent stopped: its parent hears it, and its turn ends.
          if (th.root && running.get(th.root.th.thread.id) === th.root.turn) {
            const { th: parent, turn: pt } = th.root
            item(parent, pt.id, { type: 'subAgentActivity', id: randomUUID(), kind: 'interrupted', agentThreadId: th.thread.id, agentPath: '/root/ok_agent', model: null, reasoningEffort: null }, true)
            endTurn(parent, pt, 'completed')
            status(parent, { type: 'idle' })
          }
          return
        }
        case 'thread/items/list': {
          const th = threads.get(p.threadId)
          const all = th ? th.items.filter((e) => !p.turnId || e.turnId === p.turnId) : []
          const data = (p.sortDirection === 'desc' ? [...all].reverse() : all).slice(0, p.limit || 50)
          return reply({ data, nextCursor: null, backwardsCursor: null })
        }
        // The fake TUI's own calls (the real TUI starts its thread with thread/start and turns with turn/start).
        case 'fake/hello': {
          const th = threads.get(p.resume) || makeThread(p.resume || randomUUID(), false)
          th.subs.add(ws)
          if (![...threads.values()].some((t) => t.thread.ephemeral)) makeThread(randomUUID(), true)
          return reply({ threadId: th.thread.id })
        }
        case 'fake/prompt': {
          const th = threads.get(p.threadId)
          if (!th) return
          if (p.text === 'limits') {
            // A sparse update to every client (it is the account's, not a thread's): a second window appears.
            for (const c of wss.clients) send(c, { method: 'account/rateLimits/updated', params: { rateLimits: { limitId: 'codex', limitName: null, primary: null, secondary: { usedPercent: 61, windowDurationMins: 300, resetsAt: Math.floor(Date.now() / 1000) + 3 * 3600 }, credits: null, planType: null } } })
          } else if (p.text === 'ask') {
            status(th, { type: 'active', activeFlags: ['waitingOnApproval'] })
            request(th, 'item/commandExecution/requestApproval', { kind: 'command', itemId: 'i', environmentId: null, command: "/bin/zsh -lc 'rm -rf build'", cwd: process.cwd(), reason: 'clean' })
          } else if (p.text === 'asktool') {
            // As 0.167.1 asks before an MCP tool runs (captured 11 Nov 2026): the call's item, then
            // an elicitation with Codex's approval meta; accept calls workshop's server for real.
            const call = { type: 'mcpToolCall', id: `exec-${randomUUID()}`, server: 'workshop', tool: 'reminders', status: 'inProgress', arguments: { op: 'list', args: ['--all'] }, result: null, error: null, durationMs: null }
            item(th, 't', call, false)
            status(th, { type: 'active', activeFlags: ['waitingOnApproval'] })
            request(th, 'mcpServer/elicitation/request', {
              serverName: 'workshop', mode: 'form', message: 'Allow the workshop MCP server to run tool "reminders"?', requestedSchema: { type: 'object', properties: {} },
              _meta: { codex_approval_kind: 'mcp_tool_call', persist: ['session', 'always'], tool_name: 'reminders', tool_description: '', tool_params: call.arguments, tool_params_display: [{ name: 'op', value: 'list', display_name: 'op' }, { name: 'args', value: ['--all'], display_name: 'args' }] }
            }, undefined, undefined, async (res) => {
              if (res?.action !== 'accept') return item(th, 't', { ...call, status: 'failed', error: { message: 'user rejected MCP tool call' } }, true)
              const srv = mcp.get('workshop')
              const r = srv ? (await srv.ready, await srv.rpc('tools/call', { name: 'reminders', arguments: call.arguments, _meta: { threadId: th.thread.id } })) : { error: { message: 'no server' } }
              item(th, 't', { ...call, status: r.error || r.result?.isError ? 'failed' : 'completed', result: r.result ?? null, error: r.error ?? null }, true)
            })
          } else if (p.text === 'askfile') {
            const itemId = randomUUID()
            const fc = { type: 'fileChange', id: itemId, status: 'inProgress', changes: [{ path: path.join(process.cwd(), 'notes.md'), kind: { type: 'add' }, diff: '+# Notes' }] }
            item(th, 't', fc, false)
            status(th, { type: 'active', activeFlags: ['waitingOnApproval'] })
            request(th, 'item/fileChange/requestApproval', { itemId, reason: null }, fc)
          } else if (p.text === 'askperm') {
            status(th, { type: 'active', activeFlags: ['waitingOnApproval', 'waitingOnUserInput'] })
            request(th, 'item/permissions/requestApproval', { itemId: 'p', environmentId: null, cwd: process.cwd(), reason: 'needs the network', permissions: { network: { enabled: true } } })
            request(th, 'item/tool/requestUserInput', { itemId: 'q', questions: [{ id: 'q1', header: 'Pick', question: 'Which?', options: null }] })
          } else if (p.text === 'spawn' || p.text === 'spawnslow' || p.text === 'spawnask') {
            const t = startTurn(th)
            status(th, { type: 'active', activeFlags: [] })
            item(th, t.id, { type: 'userMessage', id: randomUUID(), clientId: null, content: [{ type: 'text', text: p.text, text_elements: [] }] }, true)
            const child = makeThread(randomUUID(), false)
            Object.assign(child.thread, { parentThreadId: th.thread.id, agentNickname: 'Beauvoir', agentRole: null, model: 'gpt-fake', source: { subAgent: { thread_spawn: { parent_thread_id: th.thread.id, depth: 1, agent_path: '/root/ok_agent', agent_nickname: 'Beauvoir', agent_role: null } } } })
            child.root = { th, turn: t }
            child.born = Date.now()
            item(th, t.id, { type: 'subAgentActivity', id: randomUUID(), kind: 'started', agentThreadId: child.thread.id, agentPath: '/root/ok_agent', model: 'gpt-fake', reasoningEffort: null }, true)
            const ct = startTurn(child)
            status(child, { type: 'active', activeFlags: [] })
            if (p.text === 'spawn') {
              item(child, ct.id, { type: 'agentMessage', id: randomUUID(), text: 'OK', phase: null, memoryCitation: null, delivery: null, questions: null }, true)
              endTurn(child, ct, 'completed')
              status(child, { type: 'idle' })
              item(th, t.id, { type: 'subAgentActivity', id: randomUUID(), kind: 'completed', agentThreadId: child.thread.id, agentPath: '/root/ok_agent', model: null, reasoningEffort: null }, true)
              item(th, t.id, { type: 'agentMessage', id: randomUUID(), text: 'done', phase: null, memoryCitation: null, delivery: null, questions: null }, true)
              endTurn(th, t, 'completed')
              status(th, { type: 'idle' })
            } else if (p.text === 'spawnslow') {
              ct.cmd = { ...exec(randomUUID(), 'inProgress', null), command: "/bin/zsh -lc 'sleep 600'" }
              item(child, ct.id, ct.cmd, false)
            } else {
              setTimeout(() => {
                status(child, { type: 'active', activeFlags: ['waitingOnApproval'] })
                request(child, 'item/commandExecution/requestApproval', { kind: 'command', itemId: 'ci', environmentId: null, command: "/bin/zsh -lc 'rm -rf dist'", cwd: process.cwd(), reason: 'child cleans' }, undefined, th)
              }, 300)
            }
          } else if (p.text === 'commit' || p.text === 'quietcommit') {
            const quiet = p.text === 'quietcommit'
            const t = startTurn(th)
            status(th, { type: 'active', activeFlags: [] })
            const c = { ...exec(randomUUID(), 'inProgress', null), command: "/bin/zsh -lc 'git commit --allow-empty -m codex'" }
            if (!quiet) item(th, t.id, c, false)
            const started = Date.now()
            let code = 0
            try {
              require('node:child_process').execFileSync('git', ['-c', 'user.name=fake', '-c', 'user.email=fake@example.invalid', 'commit', '-q', '--allow-empty', '-m', quiet ? 'quiet' : 'codex'], { stdio: 'ignore' })
            } catch {
              code = 1
            }
            const doneC = { ...c, status: code ? 'failed' : 'completed', exitCode: code, durationMs: Date.now() - started }
            if (quiet) th.items.push({ turnId: t.id, item: doneC, startedAtMs: started, completedAtMs: Date.now() })
            else item(th, t.id, doneC, true)
            endTurn(th, t, 'completed')
            status(th, { type: 'idle' })
          } else if (p.text === 'slow') {
            const t = startTurn(th)
            status(th, { type: 'active', activeFlags: [] })
            item(th, t.id, { type: 'userMessage', id: randomUUID(), clientId: null, content: [{ type: 'text', text: 'slow', text_elements: [] }] }, true)
            t.cmd = { ...exec(randomUUID(), 'inProgress', null), command: "/bin/zsh -lc 'sleep 600'" }
            item(th, t.id, t.cmd, false)
          } else if (p.text === 'yes' && pending.length) {
            for (const r of pending.splice(0)) resolve(r, 'accept')
          } else turn(th, p.text)
          return reply({})
        }
        default:
          if (m.id !== undefined) send(ws, { id: m.id, error: { code: -32601, message: `fake codex: ${m.method}` } })
      }
    })
  })
  try { fs.rmSync(sock, { force: true }) } catch {}
  hs.listen(sock, () => console.log(`fake codex app-server on ${sock}`))
  const stop = () => { try { fs.rmSync(sock, { force: true }) } catch {}; process.exit(0) }
  process.on('SIGTERM', stop)
  process.on('SIGHUP', stop)
}

function tui() {
  const sock = sockOf('--remote')
  if (!sock) {
    console.error('fake codex: workshop always runs the TUI with --remote')
    process.exit(2)
  }
  if (argv.includes('--worktree')) {
    // As 0.167.1 answers it.
    console.error('Error: `--worktree` is only supported for local sessions')
    process.exit(1)
  }
  const resume = argv[0] === 'resume' ? argv[1] : null
  let target
  try {
    target = fs.realpathSync(sock)
  } catch (err) {
    console.error(`fake codex: cannot reach the app-server at ${sock}: ${err.message}`)
    process.exit(4)
  }
  const ws = new WebSocket(`ws+unix://${target}:/rpc`)
  let next = 1
  const call = (method, params) => ws.send(JSON.stringify({ jsonrpc: '2.0', id: next++, method, params }))
  let threadId = null
  ws.on('error', (err) => {
    console.error(`fake codex: cannot reach the app-server at ${sock}: ${err.message}`)
    process.exit(4)
  })
  ws.on('message', (data) => {
    const m = JSON.parse(String(data))
    if (m.id === 1 && m.result?.threadId) threadId = m.result.threadId
  })
  ws.on('open', () => {
    call('fake/hello', { resume, cwd: process.cwd() })
    fs.writeFileSync(`${sock}.tui.json`, JSON.stringify({ argv, cwd: process.cwd() }))
    console.log(`FAKE CODEX ${JSON.stringify(argv)}`)
    console.log(`CONNECTED ${sock}`)
    process.stdin.setEncoding('utf8')
    let buf = ''
    process.stdin.on('data', (d) => {
      buf += d.replace(/\r/g, '\n')
      let i
      while ((i = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, i).trim()
        buf = buf.slice(i + 1)
        if (!line) continue
        if (line === 'exit') process.exit(0)
        if (line === 'crash') process.exit(3)
        console.log(`> ${line}`)
        if (threadId) call('fake/prompt', { threadId, text: line })
      }
    })
  })
}
